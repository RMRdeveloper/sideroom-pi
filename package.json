{
  "name": "@rmrdeveloper/sideroom-pi",
  "version": "9.2.0",
  "description": "Make \"done\" mean done for Pi. Asks before it guesses, enforces your coding rules, and reviews changes before finishing.",
  "type": "module",
  "files": [
    "extensions",
    "assets",
    "skills",
    "!extensions/**/*.test.ts"
  ],
  "scripts": {
    "prepublishOnly": "npm run check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "commitlint": "commitlint",
    "types": "tsc --noEmit",
    "test": "node --test 'extensions/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "lint": "eslint extensions assets/visual-context/browser scripts commitlint.config.mjs eslint.config.mjs package.json tsconfig.json .changeset/config.json",
    "lint:fix": "eslint extensions assets/visual-context/browser scripts commitlint.config.mjs eslint.config.mjs package.json tsconfig.json .changeset/config.json --fix",
    "format": "eslint extensions assets/visual-context/browser scripts commitlint.config.mjs eslint.config.mjs package.json tsconfig.json .changeset/config.json --fix",
    "format:check": "eslint extensions assets/visual-context/browser scripts commitlint.config.mjs eslint.config.mjs package.json tsconfig.json .changeset/config.json",
    "preview": "node scripts/render-preview.mjs",
    "cache:report": "node scripts/cache-report.mjs",
    "package:browser": "node scripts/package-browser.mjs",
    "check:if-blocks": "node scripts/check-if-blocks.mjs",
    "check": "npm run types && npm run check:if-blocks && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-skill",
    "coding-agent",
    "questions",
    "clarifying-questions",
    "questionnaire",
    "planning",
    "spec",
    "todo",
    "task-board",
    "progress",
    "edited-files",
    "guidelines",
    "code-style",
    "code-quality",
    "guardrails",
    "rules",
    "linting",
    "testing",
    "done",
    "persona",
    "skills",
    "typescript",
    "tui",
    "claude",
    "sideroom_ask",
    "sideroom_todo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RMRdeveloper/sideroom-pi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "!extensions/*.test.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/RMRdeveloper/sideroom-pi/main/media/preview.png",
    "video": "https://raw.githubusercontent.com/RMRdeveloper/sideroom-pi/main/media/preview.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-no-comments": "^1.2.1",
    "fflate": "0.8.3",
    "globals": "^17.13.0",
    "typebox": "1.3.7",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@babel/parser": "^7.29.9",
    "@vue/compiler-dom": "^3.5.43",
    "ignore": "7.0.5",
    "parse5": "^8.0.1",
    "svelte": "^5.57.2",
    "ws": "^8.22.0"
  }
}
