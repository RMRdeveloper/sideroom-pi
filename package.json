{
  "name": "@rmrdeveloper/sideroom-pi",
  "version": "8.1.1",
  "description": "Pi coding-agent package that asks clarifying questions, shows a live todo board, enforces coding guidelines, and will not call it done while your checks are red.",
  "type": "module",
  "files": [
    "extensions",
    "assets",
    "skills",
    "!extensions/**/*.test.ts"
  ],
  "scripts": {
    "prepublishOnly": "npm run check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "commitlint": "commitlint",
    "types": "tsc --noEmit",
    "test": "node --test 'extensions/**/*.test.ts'",
    "lint": "biome lint extensions scripts commitlint.config.mjs",
    "lint:fix": "biome lint --write extensions scripts commitlint.config.mjs",
    "format": "biome format --write extensions scripts package.json biome.json commitlint.config.mjs .changeset/config.json",
    "format:check": "biome format extensions scripts package.json biome.json commitlint.config.mjs .changeset/config.json",
    "preview": "node scripts/render-preview.mjs",
    "check:if-blocks": "node scripts/check-if-blocks.mjs",
    "check": "npm run types && npm run check:if-blocks && biome check extensions scripts package.json biome.json commitlint.config.mjs .changeset/config.json && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-skill",
    "coding-agent",
    "questions",
    "clarifying-questions",
    "questionnaire",
    "planning",
    "spec",
    "todo",
    "task-board",
    "progress",
    "edited-files",
    "guidelines",
    "code-style",
    "code-quality",
    "guardrails",
    "rules",
    "linting",
    "testing",
    "done",
    "skills",
    "typescript",
    "tui",
    "claude",
    "sideroom_ask",
    "sideroom_todo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RMRdeveloper/sideroom-pi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/RMRdeveloper/sideroom-pi/main/media/preview.png",
    "video": "https://raw.githubusercontent.com/RMRdeveloper/sideroom-pi/main/media/preview.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.20.1",
    "typebox": "1.3.7",
    "typescript": "^5.6.0"
  }
}
