{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "coverageAnalysis": "perTest",
  "mutate": [
    "extensions/**/*.ts",
    "!extensions/**/*.test.ts"
  ],
  "ignorePatterns": [
    "site/**",
    "media/**",
    "videos/**",
    "dist/**",
    "docs/**"
  ],
  "tap": {
    "testFiles": [
      "extensions/**/*.test.ts"
    ],
    "nodeArgs": [
      "--test-reporter=tap",
      "-r",
      "{{hookFile}}",
      "{{testFile}}"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 20000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 10,
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation.html"
  },
  "thresholds": {
    "high": 100,
    "low": 99,
    "break": null
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "cleanTempDir": "always"
}
