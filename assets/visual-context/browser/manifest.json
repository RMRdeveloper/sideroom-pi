{
  "manifest_version": 3,
  "name": "Sideroom Visual Context",
  "version": "1.2.0",
  "description": "Select a page element and attach local source candidates to your Pi session.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle-inspector": {
      "suggested_key": "Alt+Shift+S",
      "description": "Start or stop selecting elements for Pi"
    }
  },
  "action": { "default_popup": "popup.html", "default_title": "Select an element for Pi", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:*"
  }
}
